<?xml version="1.0"?>
<odoo noupdate="1">

    <record id="seq_loyalty_restaurant_order" model="ir.sequence">
        <field name="name">Restaurant Order</field>
        <field name="code">loyalty.restaurant.order</field>
        <field name="prefix">RO</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_loyalty_generator" model="ir.sequence">
        <field name="name">Loyalty Generator</field>
        <field name="code">loyalty.generator</field>
        <field name="prefix">LOYALTYG-</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_loyalty_transfer" model="ir.sequence">
        <field name="name">Loyalty Transfer</field>
        <field name="code">loyalty.transfer</field>
        <field name="prefix">LTRASN-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        <field name="implementation">standard</field>
        <field name="active" eval="True"/>
    </record>


</odoo>