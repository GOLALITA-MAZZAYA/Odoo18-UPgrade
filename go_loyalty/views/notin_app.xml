<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_notin_app_form" model="ir.ui.view">
        <field name="name">notin.app.form</field>
        <field name="model">notin.app</field>
        <field name="arch" type="xml">
            <form string="Not Linked App">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id" context="{'default_entity_type': 'organisation'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_notin_app_search" model="ir.ui.view">
        <field name="name">notin.app.search</field>
        <field name="model">notin.app</field>
        <field name="arch" type="xml">
            <search string="Not Linked Apps Search">
                <field name="name" string="App Name"/>
                <field name="code" string="App Code"/>
                <field name="parent_id" string="Organisation"/>

                <filter name="filter_has_parent" string="With Organisation" domain="[('parent_id','!=',False)]"/>
                <filter name="filter_no_parent" string="Without Organisation" domain="[('parent_id','=',False)]"/>

                <group expand="1" string="Group By">
                    <filter name="group_by_org" string="Organisation" context="{'group_by':'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="view_notin_app_tree" model="ir.ui.view">
        <field name="name">notin.app.tree</field>
        <field name="model">notin.app</field>
        <field name="arch" type="xml">
            <list string="Not Linked Apps">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>


    <record id="action_notin_app" model="ir.actions.act_window">
        <field name="name">Not Linked Apps</field>
        <field name="res_model">notin.app</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Not Linked App.
            </p>
        </field>
    </record>


</odoo>
