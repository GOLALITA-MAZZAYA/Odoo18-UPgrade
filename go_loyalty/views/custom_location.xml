<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="view_custom_location_form" model="ir.ui.view">
        <field name="name">custom.location.form</field>
        <field name="model">custom.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="arabic_name"/>
                            <field name="short_name_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_location_tree" model="ir.ui.view">
        <field name="name">custom.location.tree</field>
        <field name="model">custom.location</field>
        <field name="arch" type="xml">
            <list string="Locations" create="true" edit="true">
                <field name="name"/>
                <field name="arabic_name"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="short_name_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_custom_location_search" model="ir.ui.view">
        <field name="name">custom.location.search</field>
        <field name="model">custom.location</field>
        <field name="arch" type="xml">
            <search string="Locations">
                <field name="name"/>
                <field name="arabic_name"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </search>
        </field>
    </record>



    <record id="action_custom_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">custom.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first location here.
            </p>
        </field>
    </record>



</odoo>
