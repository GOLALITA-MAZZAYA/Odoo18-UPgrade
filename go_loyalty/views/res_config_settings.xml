<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <odoo>
        <record id="res_config_settings_view_form_inherit_loyalty" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.loyalty</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='general_settings']" position="after">
                    <app data-string="Loyalty" string="Loyalty" name="go_loyalty">
                        <block title="Loyalty Configuration" name="loyalty_settings_block">
                            <setting id="gulfexc_secret_key_setting" string="GulfExc Secret Key">
                                <field name="gulfexc_secret_key"/>
                                <div class="text-muted">
                                    Enter your GulfExc Secret Key. This key will be used for API authentication.
                                </div>
                            </setting>
                            <setting id="moi_secret_key_setting" string="MOI Secret Key">
                                <field name="moi_secret_key"/>
                                <div class="text-muted">
                                    Enter your MOI Secret Key. This key will be used for API authentication.
                                </div>
                            </setting>
                            <setting id="moi_bearer_token_setting" string="MOI Bearer Token">
                                <field name="moi_bearer_token"/>
                                <div class="text-muted">
                                    Enter your MOI Bearer Token. This key will be used for API authentication.
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </odoo>


    <record id="loyalty_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_inherit_loyalty"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'go_loyalty', 'bin_size': False}</field>
    </record>


</odoo>
