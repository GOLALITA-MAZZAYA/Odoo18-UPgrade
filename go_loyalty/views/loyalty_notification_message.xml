<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loyalty_notification_message_form" model="ir.ui.view">
        <field name="name">loyalty.notification.message.form</field>
        <field name="model">loyalty.notification.message</field>
        <field name="arch" type="xml">
            <form string="Loyalty Notification Message">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="subject_arabic"/>
                        </group>
                        <group>
                            <field name="merchant_id"/>
                            <field name="org_id"/>
                            <field name="product_id"/>
                            <field name="notification_id"/>
                            <field name="imp_notification"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Message Details">
                            <group string="Message Content (English)">
                                <field name="message" nolabel="1" widget="text" placeholder="Enter message content..."/>
                            </group>
                            <group string="Message Content (Arabic)">
                                <field name="message_arabic" nolabel="1" widget="text"
                                       placeholder="Enter message content..."/>
                            </group>
                        </page>

                        <page string="Descriptions">
                            <group string="Descriptions (English)">
                                <field name="description" nolabel="1" widget="html"/>
                            </group>
                            <group string="Descriptions (Arabic)">
                                <field name="description_arabic" nolabel="1" widget="html"/>
                            </group>
                        </page>

                        <page string="Offer &amp; Image">
                            <group>
                                <field name="offer_image" widget="image" class="oe_image" options="{'size': [800, 600]}"
                                       string="Offer Image"/>
                            </group>
                            <group>
                                <field name="url" widget="url" string="Redirect URL"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_loyalty_notification_message_tree" model="ir.ui.view">
        <field name="name">loyalty.notification.message.tree</field>
        <field name="model">loyalty.notification.message</field>
        <field name="arch" type="xml">
            <list string="Loyalty Notification Messages" default_order="id desc">
                <field name="subject"/>
                <field name="merchant_id"/>
                <field name="org_id"/>
                <field name="product_id"/>
                <field name="notification_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'sent'"/>

                <field name="imp_notification"/>
            </list>
        </field>
    </record>


    <record id="view_loyalty_notification_message_search" model="ir.ui.view">
        <field name="name">loyalty.notification.message.search</field>
        <field name="model">loyalty.notification.message</field>
        <field name="arch" type="xml">
            <search string="Loyalty Notification Messages">
                <field name="subject"/>
                <field name="merchant_id"/>
                <field name="org_id"/>
                <field name="product_id"/>
                <filter name="important_only" string="Important Only" domain="[('imp_notification','=',True)]"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <group expand="0" string="Group By">
                    <filter string="Merchant" name="group_merchant" context="{'group_by':'merchant_id'}"/>
                    <filter string="Organisation" name="group_org" context="{'group_by':'org_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_loyalty_notification_message" model="ir.actions.act_window">
        <field name="name">Notification Messages</field>
        <field name="res_model">loyalty.notification.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage loyalty notification messages here.</p>
        </field>
    </record>

</odoo>
