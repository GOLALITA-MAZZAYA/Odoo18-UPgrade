<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loyalty_notification_form" model="ir.ui.view">
        <field name="name">loyalty.notification.form</field>
        <field name="model">loyalty.notification</field>
        <field name="arch" type="xml">
            <form string="Loyalty Notification">
                <sheet>
                    <group>
                        <group>
                            <field name="merchant_id"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Subscribers">
                            <field name="line_ids" readonly="1">
                                <list string="Subscribers">
                                    <field name="partner_id"/>
                                    <field name="device_id"/>
                                    <field name="is_subscribe"/>
                                </list>
                                <form string="Subscriber Details">
                                    <group>
                                        <group>
                                            <field name="notification_id" readonly="1"/>
                                            <field name="partner_id" readonly="1"/>
                                            <field name="device_id" readonly="1"/>
                                            <field name="is_subscribe" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loyalty_notification_tree" model="ir.ui.view">
        <field name="name">loyalty.notification.tree</field>
        <field name="model">loyalty.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="merchant_id"/>
            </list>
        </field>
    </record>


    <record id="view_loyalty_notification_search" model="ir.ui.view">
        <field name="name">loyalty.notification.search</field>
        <field name="model">loyalty.notification</field>
        <field name="arch" type="xml">
            <search string="Loyalty Notifications">
                <field name="merchant_id"/>
                <filter string="With Subscribers" name="with_subscribers"
                        domain="[('line_ids', '!=', False)]"/>
                <filter string="Without Subscribers" name="without_subscribers"
                        domain="[('line_ids', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Merchant" name="group_merchant" context="{'group_by': 'merchant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_loyalty_notification" model="ir.actions.act_window">
        <field name="name">Loyalty Notifications</field>
        <field name="res_model">loyalty.notification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>View all merchant-specific loyalty notification records here.</p>
        </field>
    </record>


</odoo>
