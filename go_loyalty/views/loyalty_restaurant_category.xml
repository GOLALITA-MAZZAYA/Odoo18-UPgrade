<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_loyalty_restaurant_category_form" model="ir.ui.view">
        <field name="name">loyalty.restaurant.category.form</field>
        <field name="model">loyalty.restaurant.category</field>
        <field name="arch" type="xml">
            <form string="Restaurant Category">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="name"/>
                            <field name="name_arabic"/>
                        </group>
                        <group string="Hierarchy &amp; Identification">
                            <field name="complete_name"/>
                            <field name="parent_path"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Subcategories">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="name_arabic"/>
                                    <field name="complete_name" readonly="1"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_loyalty_restaurant_category_tree" model="ir.ui.view">
        <field name="name">loyalty.restaurant.category.list</field>
        <field name="model">loyalty.restaurant.category</field>
        <field name="arch" type="xml">
            <list string="Restaurant Categories">
                <field name="name"/>
                <field name="name_arabic"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>


    <record id="view_loyalty_restaurant_category_search" model="ir.ui.view">
        <field name="name">loyalty.restaurant.category.search</field>
        <field name="model">loyalty.restaurant.category</field>
        <field name="arch" type="xml">
            <search string="Restaurant Categories">
                <field name="name" string="Category Name"/>
                <field name="parent_id" string="Parent Category"/>
                <filter name="filter_with_parent" string="Has Parent" domain="[('parent_id','!=',False)]"/>
            </search>
        </field>
    </record>


    <record id="action_loyalty_restaurant_category" model="ir.actions.act_window">
        <field name="name">Restaurant Categories</field>
        <field name="res_model">loyalty.restaurant.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first restaurant category
            </p>
        </field>
    </record>


</odoo>
