<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_merchant_matrix_form" model="ir.ui.view">
        <field name="name">merchant.matrix.form</field>
        <field name="model">merchant.matrix</field>
        <field name="arch" type="xml">
            <form string="Merchant Matrix">
                <sheet>
                    <group>
                        <group>
                            <field name="res_partner_id"/>
                            <field name="employee_type"/>
                            <field name="organisation_id" widget="many2many_tags"/>
                            <field name="offer_details"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="created_by"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Discount Tag">
                            <field name="discount_tag"/>
                        </page>

                        <page string="Discount Tag Arabic">
                            <field name="discount_tag_arabic"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_merchant_matrix_tree" model="ir.ui.view">
        <field name="name">merchant.matrix.tree</field>
        <field name="model">merchant.matrix</field>
        <field name="arch" type="xml">
            <list string="Merchant Matrix">
                <field name="res_partner_id"/>
                <field name="organisation_id" widget="many2many_tags"/>
                <field name="offer_details"/>
                <field name="employee_type"/>
                <field name="create_date"/>
                <field name="created_by"/>
            </list>
        </field>
    </record>

    <record id="action_merchant_matrix" model="ir.actions.act_window">
        <field name="name">Merchant Matrix</field>
        <field name="res_model">merchant.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Merchant Matrix.
            </p>
        </field>
    </record>


</odoo>
