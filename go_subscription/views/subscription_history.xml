<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_history_form" model="ir.ui.view">
        <field name="name">subscription.history.form</field>
        <field name="model">subscription.history</field>
        <field name="arch" type="xml">
            <form string="Subscription" create="0" edit="0">
                <header>
                    <field name="payment_state" widget="statusbar" statusbar_visible="pending,paid,failed"/>
                  
                </header>
                <sheet>
                    <group>
                        <group string="Customer &amp; Plan">
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="subscription_reference"/>
                            <field name="price"/>
                        </group>

                        <group string="Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Payment Details">
                            <group>
                                <field name="payment_reference"/>
                                <field name="payment_web_link" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_subscription_history_tree" model="ir.ui.view">
        <field name="name">subscription.history.tree</field>
        <field name="model">subscription.history</field>
        <field name="arch" type="xml">
            <list string="Subscription Histories" create="0" edit="0">
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="subscription_reference"/>
                <field name="price"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="payment_state" widget="badge" optional="show"
                       decoration-info="payment_state=='pending'"
                       decoration-success="payment_state=='paid'"
                       decoration-danger="payment_state=='failed'"/>

            </list>
        </field>
    </record>


    <record id="view_subscription_history_search" model="ir.ui.view">
        <field name="name">subscription.history.search</field>
        <field name="model">subscription.history</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="subscription_reference"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="payment_state"/>
                <field name="is_active"/>
                <group expand="0" string="Group By">
                    <filter name="customer_filter" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="plan_filter" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="payment_status_filter" string="Payment Status"
                            context="{'group_by': 'payment_state'}"/>
                    <filter name="active_state_filter" string="Active State" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_subscription_history" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subscriptions found.
            </p>
            <p>
                Subscriptions represent each customer's purchased plan, payment, and duration.
            </p>
        </field>
    </record>


</odoo>
