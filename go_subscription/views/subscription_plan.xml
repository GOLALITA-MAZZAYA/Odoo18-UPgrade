<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <group string="General Information">
                        <group>
                            <field name="name"/>
                            <field name="arabic_name"/>
                            <field name="code"/>

                        </group>
                        <group>
                            <field name="duration_days"/>
                            <field name="price"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Plan Descriptions">
                            <group string="English Description">
                                <field name="description" nolabel="1"/>
                            </group>

                            <group string="Arabic Description">
                                <field name="arabic_description" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Subscribers">
                            <field name="active_user_ids" mode="list" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="subscription_reference"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="is_active"/>
                                    <field name="payment_state"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="partner_id"/>
                                        <field name="subscription_reference"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="is_active"/>
                                        <field name="payment_reference"/>
                                        <field name="payment_web_link"/>
                                        <field name="payment_state"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Subscription Codes">
                            <field name="subscription_code_ids" mode="list" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="merchant_id"/>
                                    <field name="expiry_date"/>
                                    <field name="is_redeemed"/>
                                    <field name="redeemed_by"/>
                                    <field name="redeemed_on"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="plan_id"/>
                                        <field name="merchant_id"/>
                                        <field name="expiry_date"/>
                                        <field name="is_redeemed"/>
                                        <field name="redeemed_by"/>
                                        <field name="redeemed_on"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_subscription_plan_tree" model="ir.ui.view">
        <field name="name">subscription.plan.tree</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="duration_days"/>
                <field name="price"/>
            </list>
        </field>
    </record>


    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Search Subscription Plans">
                <field name="name"/>
                <field name="code"/>

                <filter name="short_plans" string="Short Duration (&lt;=30 days)"
                        domain="[('duration_days','&lt;=',30)]"/>
                <filter name="high_price" string="Premium Plans (&gt;=1000 QAR)" domain="[('price','&gt;=',1000)]"/>
            </search>
        </field>
    </record>


    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Subscription Plan
            </p>
        </field>
    </record>


</odoo>
