<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="discuss.channel" id="channel_chatgpt">
            <field name="name">ChatGPT</field>
            <field name="description">ChatGPT Integration</field>
            <field name="image_128" type="base64" file="go_chatgpt/static/description/chatgpt.png"/>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record model="mail.message" id="module_install_notification">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="go_chatgpt.channel_chatgpt"/>
            <field name="message_type">comment</field>
            <field name="author_id" eval="False"/>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="subject">Welcome to ChatGPT Channel!</field>
            <field name="body"><![CDATA[
                <p>Welcome to the #ChatGPT channel.</p>
                <p>Ask your questions to ChatGPT.</p>
            ]]></field>
        </record>


        <record model="discuss.channel.member" id="go_discuss_channel_member">
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="channel_id" ref="go_chatgpt.channel_chatgpt"/>
            <field name="fetched_message_id" ref="go_chatgpt.module_install_notification"/>
            <field name="seen_message_id" ref="go_chatgpt.module_install_notification"/>
        </record>

    </data>
</odoo>