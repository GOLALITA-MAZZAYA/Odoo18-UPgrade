<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_res_config_settings_inherit_whatsapp" model="ir.ui.view">
            <field name="name">res.config.settings.whatsapp.api</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invite_users']" position="before">
                    <div id="whatsapp_api_container">
                        <block title="WhatsApp Integration" name="whatsapp_api_block">
                            <setting name="whatsapp_api_url"
                                     help="Base URL of the WhatsApp provider API">
                                <field name="whatsapp_api_url" placeholder="Enter WhatsApp API URL"/>
                            </setting>

                            <setting name="whatsapp_api_token"
                                     help="Authentication token provided by your WhatsApp API provider.">
                                <field name="whatsapp_api_token" placeholder="Enter WhatsApp API Token"/>
                            </setting>

                            <setting name="whatsapp_instance_id"
                                     help="Unique instance identifier from your WhatsApp API provider, used to route messages.">
                                <field name="whatsapp_instance_id" placeholder="Enter WhatsApp Instance ID"/>
                            </setting>
                        </block>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
