<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar" nolabel="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Brand Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="visible_slider" widget="boolean_toggle"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="General Information">
                            <group>
                                <group>
                                    <field name="brand_description"/>
                                </group>

                                <group>
                                    <field name="description" widget="html"/>
                                    <field name="products_count" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Products">
                            <field name="brand_product_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="invoice_policy"/>
                                    <field name="list_price"/>
                                    <field name="categ_id"/>
                                    <field name="sale_ok" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list string="Product Brands">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="visible_slider" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="products_count" string="Products"/>
            </list>
        </field>
    </record>

     <record id="view_product_brand_search" model="ir.ui.view">
        <field name="name">product.brand.search</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <search string="Search Product Brands">
                <field name="name" string="Brand Name"/>
                <filter name="active_only" string="Active Brands" domain="[('active','=',True)]"/>
                <filter name="inactive_only" string="Inactive Brands" domain="[('active','=',False)]"/>
                <filter name="website_visible" string="Visible on Website" domain="[('visible_slider','=',True)]"/>
                <group expand="1" string="Group By">
                    <filter string="Active" name="group_active" context="{'group_by':'active'}"/>
                    <filter string="Website Visibility" name="group_visible" context="{'group_by':'visible_slider'}"/>
                </group>
            </search>
        </field>
    </record>



    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first product brand!
            </p>
        </field>
    </record>


</odoo>