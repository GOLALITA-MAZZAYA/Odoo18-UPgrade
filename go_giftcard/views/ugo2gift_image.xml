<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_ugo2gift_image_form" model="ir.ui.view">
        <field name="name">ugo2gift.image.form</field>
        <field name="model">ugo2gift.image</field>
        <field name="arch" type="xml">
            <form string="Brand Image">
                <sheet>
                    <group string="General Information">
                        <field name="brand_id"/>
                        <field name="image_url" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_ugo2gift_image_tree" model="ir.ui.view">
        <field name="name">ugo2gift.image.tree</field>
        <field name="model">ugo2gift.image</field>
        <field name="arch" type="xml">
            <list string="Brand Images">
                <field name="brand_id"/>
                <field name="image_url" widget="url"/>
            </list>
        </field>
    </record>


    <record id="view_ugo2gift_image_search" model="ir.ui.view">
        <field name="name">ugo2gift.image.search</field>
        <field name="model">ugo2gift.image</field>
        <field name="arch" type="xml">
            <search string="Search Images">
                <field name="brand_id" string="Brand"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_brand" string="Brand" context="{'group_by':'brand_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_ugo2gift_image" model="ir.actions.act_window">
        <field name="name">Images</field>
        <field name="res_model">ugo2gift.image</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ugo2gift_image_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload brand-related images for your gift cards.
            </p>
        </field>
    </record>

</odoo>
