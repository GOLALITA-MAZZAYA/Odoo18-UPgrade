<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ugo2gift_brand_form" model="ir.ui.view">
        <field name="name">ugo2gift.brand.form</field>
        <field name="model">ugo2gift.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <header>
                    <button name="action_fetch_brand"
                            type="object"
                            string="Fetch Brand"
                    />
                </header>

                <sheet>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Brand Name..."/>
                        </h1>
                    </div>


                    <group>
                        <group string="Identification">
                            <field name="brand_code"/>
                            <field name="brand_id"/>
                            <field name="tagline"/>
                        </group>
                        <group string="Options">
                            <field name="is_generic"/>
                            <field name="pin_redeemable"/>
                            <field name="variable_amount"/>
                        </group>
                    </group>


                    <notebook>


                        <page string="General Information">
                            <group>
                                <group>
                                    <field name="rate"/>
                                    <field name="validity_in_months"/>
                                </group>
                                <group>
                                    <field name="category_ids" widget="many2many_tags"/>
                                    <field name="country_ids" widget="many2many_tags"/>
                                </group>
                            </group>

                            <group string="description">
                                <field name="description" widget="text" nolabel="1" colspan="4"/>
                            </group>
                        </page>

                        <page string="Denominations">
                            <field name="denomination_ids">
                                <list editable="bottom">
                                    <field name="currency_id"/>
                                    <field name="amount"/>
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                </list>
                            </field>
                        </page>

                        <page string="Redemption">
                            <group string="Redemption Details">
                                <group>
                                    <field name="brand_accepted_currency_id"/>
                                    <field name="redemption_type"/>
                                </group>
                                <group>
                                    <field name="detail_url" widget="url"/>
                                    <field name="locations_url" widget="url"/>
                                </group>
                            </group>
                            <group string="Redemption Instructions">
                                <field name="redemption_instructions"
                                       widget="text"
                                       nolabel="1"
                                       colspan="4"
                                       placeholder="Enter redemption instructions ..."
                                />
                            </group>
                        </page>


                        <page string="Media &amp; Images">
                            <group string="Main Media">
                                <group>
                                    <field name="logo_url" widget="url"/>
                                </group>
                                <group>
                                    <field name="product_image_url" widget="url"/>
                                </group>
                            </group>
                            <group string="Image Gallery">
                                <field name="image_gallery_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="image_url" widget="url"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_ugo2gift_brand_tree" model="ir.ui.view">
        <field name="name">ugo2gift.brand.tree</field>
        <field name="model">ugo2gift.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand_code"/>
                <field name="brand_id"/>
                <field name="rate"/>
                <field name="is_generic"/>
                <field name="validity_in_months"/>
                <field name="brand_accepted_currency_id"/>
                <field name="redemption_type"/>
                <field name="category_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <odoo>
        <record id="view_ugo2gift_brand_search" model="ir.ui.view">
            <field name="name">ugo2gift.brand.search</field>
            <field name="model">ugo2gift.brand</field>
            <field name="arch" type="xml">
                <search string="Search Brands">

                    <field name="name" string="Brand Name"/>
                    <field name="brand_code" string="Brand Code"/>
                    <field name="brand_id" string="Brand ID"/>
                    <field name="tagline" string="Tagline"/>
                    <field name="redemption_type" string="Redemption Type"/>


                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active','=',False)]"/>
                    <filter string="Generic Brand" name="is_generic" domain="[('is_generic','=',True)]"/>
                    <filter string="PIN Redeemable" name="pin_redeemable" domain="[('pin_redeemable','=',True)]"/>
                    <filter string="Variable Amount" name="variable_amount" domain="[('variable_amount','=',True)]"/>


                    <group expand="0" string="Group By">
                        <filter string="Accepted Currency" name="group_currency"
                                context="{'group_by':'brand_accepted_currency_id'}"/>
                        <filter string="Generic" name="group_generic" context="{'group_by':'is_generic'}"/>
                    </group>

                </search>
            </field>
        </record>
    </odoo>


    <record id="action_ugo2gift_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">ugo2gift.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Gift Card Brand
            </p>
        </field>
    </record>


</odoo>