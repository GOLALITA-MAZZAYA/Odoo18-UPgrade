<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_giftcard" model="ir.ui.view">
        <field name="name">res.config.settings.giftcard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='general_settings']" position="after">

                <app string="Gift Card" name="go_giftcard"
                     logo="/go_giftcard/static/description/gift_card_logo.png">


                    <block title="Gift API Credentials" name="gift_api_settings_container">
                        <setting id="gift_api_setting" string="Gift API Configuration"
                                 help="Set API credentials to connect with the Gift service.">

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="gift_api_url" class="o_light_label" string="API URL"/>
                                    <field name="gift_api_url" placeholder="https://b2b.yougotagift.com/corporate/api"
                                           class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="gift_api_key" class="o_light_label" string="API Key"/>
                                    <field name="gift_api_key" placeholder="Enter Gift API Key" class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="gift_api_secret" class="o_light_label" string="API Secret"/>
                                    <field name="gift_api_secret" placeholder="Enter Gift API Secret" class="w-100"
                                           password="True"/>
                                </div>
                            </div>

                        </setting>

                        <setting id="gift_brand_setting" string="Gift Brand Configuration"
                                 help="Select the country for brands and fetch available brands from Gift API.">

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="brand_country_id" class="o_light_label" string="Brand Country"/>
                                    <field name="brand_country_id" options="{'no_open': True}" class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <button name="action_fetch_brands"
                                            type="object"
                                            string="Fetch Brands"
                                            class="btn btn-primary"/>
                                </div>
                            </div>

                        </setting>

                    </block>
                    <block title="Cardmoola API Credentials" name="cardmoola_api_settings_container">
                        <setting id="cardmoola_api_setting" string="Cardmoola API Configuration"
                                 help="Set API credentials to connect with the Cardmoola Gift service.">

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="cardmoola_api_url" class="o_light_label" string="API URL"/>
                                    <field name="cardmoola_api_url" placeholder="https://api.business.cardmoola.com"
                                           class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="cardmoola_api_key" class="o_light_label" string="API Key"/>
                                    <field name="cardmoola_api_key" placeholder="Enter Cardmoola API Key"
                                           class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="cardmoola_api_secret" class="o_light_label" string="API Secret"/>
                                    <field name="cardmoola_api_secret" placeholder="Enter Cardmoola API Secret"
                                           class="w-100"
                                           password="True"/>
                                </div>
                            </div>

                        </setting>
                    </block>
                    <block title="SkipCash API Credentials" name="skipcash_api_settings_container">
                        <setting id="skipcash_api_setting" string="SkipCash API Configuration"
                                 help="Set API credentials to connect with the SkipCash payment gateway.">

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="skipcash_api_url" class="o_light_label" string="API URL"/>
                                    <field name="skipcash_api_url" placeholder="https://api.skipcash.app/api"
                                           class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16">
                                <div class="col-12">
                                    <label for="skipcash_merchant_key" class="o_light_label" string="Merchant Key"/>
                                    <field name="skipcash_merchant_key" placeholder="Enter SkipCash Merchant Key"
                                           class="w-100"/>
                                </div>
                            </div>

                            <div class="row mt16" id="skipcash_merchant_password_setting">
                                <div class="col-12">
                                    <label for="skipcash_merchant_password" class="o_light_label"
                                           string="Merchant Password"/>
                                    <field name="skipcash_merchant_password"
                                           placeholder="Enter SkipCash Merchant Password" class="w-100"
                                           password="True"/>
                                </div>
                            </div>

                        </setting>
                    </block>
                </app>

            </xpath>
        </field>
    </record>


    <record id="action_giftcard_settings" model="ir.actions.act_window">
        <field name="name">Gift Card Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'go_giftcard', 'bin_size': False}</field>
    </record>


</odoo>
