<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_ad_banners" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ad.banners</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add a new notebook or extend an existing one -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Advertisement 1">
                    <field name="ad_1_ids" nolabel="1"
                           context="{'default_company_id': id, 'default_slot': 'ad_1'}">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="name" required="1"/>
                            <field name="slot"/>
                            <field name="image" widget="image" options="{'preview_image': 'image_128'}"/>
                            <field name="banner_url" widget="url"/>
                            <field name="android"/>
                            <field name="ios"/>
                            <field name="internal"/>
                            <field name="organisation_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   domain="[('entity_type','=','organisation')]"/>
                            <field name="merchant_id"
                                   domain="[('entity_type','=','merchant')]"
                                   context="{'default_entity_type': 'merchant'}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="active"/>
                                        <field name="sequence"/>
                                        <field name="name" required="1"/>
                                        <field name="slot" readonly="1"/>
                                        <field name="company_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="banner_url" widget="url"/>
                                        <field name="tracking_code"/>
                                        <field name="sjc_code"/>
                                        <field name="android"/>
                                        <field name="ios"/>
                                        <field name="internal"/>
                                    </group>
                                </group>
                                <group string="Media">
                                    <field name="image" widget="image"
                                           options="{'preview_image': 'image_512'}"/>
                                </group>
                                <group string="Links">
                                    <field name="organisation_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                           domain="[('entity_type','=','organisation')]"/>
                                    <field name="merchant_id"
                                           domain="[('entity_type','=','merchant')]"
                                           context="{'default_entity_type': 'merchant'}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

                <page string="Advertisement 2">
                    <field name="ad_2_ids" nolabel="1"
                           context="{'default_company_id': id, 'default_slot': 'ad_2'}">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="name" required="1"/>
                            <field name="slot" />
                            <field name="image" widget="image" options="{'preview_image': 'image_128'}"/>
                            <field name="banner_url" widget="url"/>
                            <field name="android"/>
                            <field name="ios"/>
                            <field name="internal"/>
                            <field name="organisation_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   domain="[('entity_type','=','organisation')]"/>
                            <field name="merchant_id"
                                   domain="[('entity_type','=','merchant')]"
                                   context="{'default_entity_type': 'merchant'}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="active"/>
                                        <field name="sequence"/>
                                        <field name="name" required="1"/>
                                        <field name="slot" readonly="1"/>
                                        <field name="company_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="banner_url" widget="url"/>
                                        <field name="tracking_code"/>
                                        <field name="sjc_code"/>
                                        <field name="android"/>
                                        <field name="ios"/>
                                        <field name="internal"/>
                                    </group>
                                </group>
                                <group string="Media">
                                    <field name="image" widget="image"
                                           options="{'preview_image': 'image_512'}"/>
                                </group>
                                <group string="Links">
                                    <field name="organisation_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                           domain="[('entity_type','=','organisation')]"/>
                                    <field name="merchant_id"
                                           domain="[('entity_type','=','merchant')]"
                                           context="{'default_entity_type': 'merchant'}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

                <page string="Advertisement 3">
                    <field name="ad_3_ids" nolabel="1"
                           context="{'default_company_id': id, 'default_slot': 'ad_3'}">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="name" required="1"/>
                            <field name="slot" />
                            <field name="image" widget="image" options="{'preview_image': 'image_128'}"/>
                            <field name="banner_url" widget="url"/>
                            <field name="android"/>
                            <field name="ios"/>
                            <field name="internal"/>
                            <field name="organisation_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   domain="[('entity_type','=','organisation')]"/>
                            <field name="merchant_id"
                                   domain="[('entity_type','=','merchant')]"
                                   context="{'default_entity_type': 'merchant'}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="active"/>
                                        <field name="sequence"/>
                                        <field name="name" required="1"/>
                                        <field name="slot" readonly="1"/>
                                        <field name="company_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="banner_url" widget="url"/>
                                        <field name="tracking_code"/>
                                        <field name="sjc_code"/>
                                        <field name="android"/>
                                        <field name="ios"/>
                                        <field name="internal"/>
                                    </group>
                                </group>
                                <group string="Media">
                                    <field name="image" widget="image"
                                           options="{'preview_image': 'image_512'}"/>
                                </group>
                                <group string="Links">
                                    <field name="organisation_id"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                           domain="[('entity_type','=','organisation')]"/>
                                    <field name="merchant_id"
                                           domain="[('entity_type','=','merchant')]"
                                           context="{'default_entity_type': 'merchant'}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
