    <record id="view_advertisement_banner_search" model="ir.ui.view">
        <field name="model">advertisement.banner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="slot"/>
                <field name="company_id"/>
                <field name="organisation_id"/>
                <field name="merchant_id"/>
                <separator/>
                <filter
                        name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]"
                />
                <separator/>
                <filter
                        name="android"
                        string="Android"
                        domain="[('android', '=', True)]"
                />
                <filter
                        name="ios"
                        string="IOS"
                        domain="[('ios', '=', True)]"
                />
                <separator/>
                <filter
                        name="ad_1"
                        string="Advertisement 1"
                        domain="[('slot', '=', 'ad_1')]"
                />
                <filter
                        name="ad_2"
                        string="Advertisement 2"
                        domain="[('slot', '=', 'ad_2')]"
                />
                <filter
                        name="ad_3"
                        string="Advertisement 3"
                        domain="[('slot', '=', 'ad_3')]"
                />
                <group name="groupby">
                    <filter
                            name="groupby_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                    />
                    <filter
                            name="groupby_slot"
                            string="Slot"
                            context="{'group_by': 'slot'}"
                    />
                    <filter
                            name="groupby_organisation"
                            string="Organisation"
                            context="{'group_by': 'organisation_id'}"
                    />
                    <filter
                            name="groupby_merchant"
                            string="Merchant"
                            context="{'group_by': 'merchant_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_advert_banner" model="ir.actions.act_window">
        <field name="name">Advert Menu</field>
        <field name="res_model">advertisement.banner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_advertisement_banner_search"/>
    </record>

</odoo>
