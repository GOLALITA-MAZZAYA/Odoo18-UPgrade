<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree (editable) -->
    <record id="view_advert_banner_list" model="ir.ui.view">
        <field name="name">advertisement.banner.list</field>
        <field name="model">advertisement.banner</field>
        <field name="arch" type="xml">
            <list string="Advert Banners" editable="top">
                <field name="sequence"/>
                <field name="name" required="1"/>
                <field name="slot" required="1"/>
                <field name="image" widget="image" options="{'preview_image': 'image_256'}"/>
                <field name="banner_url" widget="url"/>
                <field name="tracking_code"/>
                <field name="android"/>
                <field name="ios"/>
                <field name="internal"/>
                <field name="sjc_code"/>
                <field name="organisation_id"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                       domain="[('entity_type','=','organisation')]"/>
                <field name="merchant_id"
                       domain="[('entity_type','=','merchant')]"
                       context="{'default_entity_type': 'merchant'}"/>
                <field name="company_id"/>
                <!--                <button name="action_open_attachments" type="object" icon="fa-paperclip"-->
                <!--                        title="Open Attachments"/>-->
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_advert_banner_form" model="ir.ui.view">
        <field name="name">advertisement.banner.form</field>
        <field name="model">advertisement.banner</field>
        <field name="arch" type="xml">
            <form string="Advert Banner">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="name" required="1"/>
                            <field name="slot" required="1"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="banner_url" widget="url"/>
                            <field name="tracking_code"/>
                            <field name="sjc_code"/>
                            <field name="android"/>
                            <field name="ios"/>
                            <field name="internal"/>
                        </group>
                    </group>

                    <group string="Media &amp; Links">
                        <group>
                            <field name="image" widget="image"
                                   options="{'preview_image': 'image_512'}"/>
                            <!--                            <button name="action_open_attachments" type="object"-->
                            <!--                                    string="Open Attachments" class="btn-link"/>-->
                        </group>
                        <group>
                            <field name="organisation_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   domain="[('entity_type','=','organisation')]"/>
                            <field name="merchant_id"
                                   domain="[('entity_type','=','merchant')]"
                                   context="{'default_entity_type': 'merchant'}"/>
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

